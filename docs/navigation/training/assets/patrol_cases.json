{
  "units": "metres, seconds, radians; synthetic input only",
  "parameters": {
    "dt": 0.1,
    "max_speed": 0.2,
    "input_timeout": 0.5,
    "stop_distance": 0.5,
    "clear_distance": 0.8
  },
  "waypoints": [[0.2, 0.0], [0.2, 0.2]],
  "scenarios": {
    "normal": {
      "obstacles": [[0.0, 2.0]],
      "expected": {"state": "SUCCEEDED", "total_time": 2.0, "reached_points": 2, "pose": [0.2, 0.2, 0.0], "waypoint_times": [1.0, 2.0]}
