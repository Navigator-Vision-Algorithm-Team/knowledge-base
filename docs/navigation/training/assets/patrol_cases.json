    "obstacle": {
      "obstacles": [[0.0, 2.0], [0.5, 0.4], [0.7, 0.6], [0.9, 0.8], [1.2, 0.9]],
      "expected": {"state": "SUCCEEDED", "total_time": 2.7, "reached_points": 2, "pose": [0.2, 0.2, 0.0], "waypoint_times": [1.7, 2.7]}
    },
    "cancel": {
      "obstacles": [[0.0, 2.0]],
      "cancel_at": 0.5,
      "expected": {"state": "CANCELED", "total_time": 0.5, "reached_points": 0, "pose": [0.1, 0.0, 0.0], "waypoint_times": []}
    },
    "timeout": {
      "obstacles": [[0.0, 2.0]],
      "last_input_at": 0.4,
      "expected": {"state": "ABORTED", "total_time": 0.9, "reached_points": 0, "pose": [0.18, 0.0, 0.0], "waypoint_times": []}
    }
